# ============================================================
# OpenAPI Specification for Payment API
# ============================================================
# This file is the formal contract of the Payment API.
# It describes:
# - Available endpoints
# - Authentication method
# - Request/response schemas
# - Error handling
# - Business rules at the API level
#
# Tools like Swagger UI, Postman, and client SDK generators
# use this file to understand how the API works.
# ============================================================

openapi: 3.0.3

# ------------------------------------------------------------
# API metadata
# ------------------------------------------------------------
info:
  title: Payment API
  description: |
    A secure, transaction-based Payment API implemented in pure PHP.

    Features:
    - API-key authentication
    - Account deposits and withdrawals
    - Card-to-card transfers
    - Database-backed transactional integrity
    - Idempotent operations
    - Clear error handling for business rule violations

    This API is designed following backend best practices
    with strong emphasis on data integrity and correctness.
  version: "1.0.0"

# ------------------------------------------------------------
# Server environments
# ------------------------------------------------------------
# These are example base URLs where the API can run.
# Swagger UI allows switching between them.
# ------------------------------------------------------------
servers:
  - url: http://localhost:8000
    description: Local development server
  - url: https://api.example.com
    description: Production server

# ------------------------------------------------------------
# Global security requirement
# ------------------------------------------------------------
# Every endpoint requires an API key unless explicitly overridden.
# ------------------------------------------------------------
security:
  - ApiKeyAuth: []

# ------------------------------------------------------------
# Reusable components
# ------------------------------------------------------------
components:

  # ----------------------------------------------------------
  # Security schemes
  # ----------------------------------------------------------
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-KEY
      description: |
        API key required to access protected endpoints.
        Requests without this header will return HTTP 401.

  # ----------------------------------------------------------
  # Shared data schemas
  # ----------------------------------------------------------
  schemas:

    # --------------------------------------------------------
    # Standard error response schema
    # --------------------------------------------------------
    ErrorResponse:
      type: object
      properties:
        error:
          type: string
          example: "Validation failed"
        message:
          type: string
          example: "Insufficient funds"

    # --------------------------------------------------------
    # Deposit request
    # --------------------------------------------------------
    DepositRequest:
      type: object
      required:
        - iban
        - amount
      properties:
        iban:
          type: string
          description: Target account IBAN
          example: BH12PAY123456789
        amount:
          type: number
          format: decimal
          minimum: 0.01
          example: 100.00

    # --------------------------------------------------------
    # Withdrawal request
    # --------------------------------------------------------
    WithdrawalRequest:
      type: object
      required:
        - iban
        - amount
      properties:
        iban:
          type: string
          description: Source account IBAN
          example: BH12PAY123456789
        amount:
          type: number
          format: decimal
          minimum: 0.01
          example: 50.00

    # --------------------------------------------------------
    # Transfer request
    # --------------------------------------------------------
    TransferRequest:
      type: object
      required:
        - from_iban
        - to_iban
        - amount
      properties:
        from_iban:
          type: string
          description: Sender IBAN
          example: BH12PAY123456789
        to_iban:
          type: string
          description: Receiver IBAN
          example: BH98PAY987654321
        amount:
          type: number
          format: decimal
          minimum: 0.01
          example: 25.50

    # --------------------------------------------------------
    # Transaction response
    # --------------------------------------------------------
    TransactionResponse:
      type: object
      properties:
        transaction_group_id:
          type: string
          description: Unique identifier for the transaction operation
          example: grp_a1b2c3
        amount:
          type: number
          example: 25.50
        status:
          type: string
          example: completed
        created_at:
          type: string
          example: "2026-01-26 14:30:00"

# ------------------------------------------------------------
# API endpoints
# ------------------------------------------------------------
paths:

  # ----------------------------------------------------------
  # Deposit endpoint
  # ----------------------------------------------------------
  /v1/deposit:
    post:
      summary: Deposit funds into an account
      description: |
        Credits funds to the specified account.
        The operation is executed inside a database transaction
        to guarantee consistency.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DepositRequest'
      responses:
        "201":
          description: Deposit successful
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransactionResponse'
        "401":
          description: Missing or invalid API key
        "422":
          description: Validation or business rule error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        "500":
          description: Internal server error

  # ----------------------------------------------------------
  # Withdrawal endpoint
  # ----------------------------------------------------------
  /v1/withdraw:
    post:
      summary: Withdraw funds from an account
      description: |
        Debits funds from the specified account.
        If the account balance is insufficient,
        the request is rejected with a business-rule error.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/WithdrawalRequest'
      responses:
        "201":
          description: Withdrawal successful
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransactionResponse'
        "401":
          description: Missing or invalid API key
        "422":
          description: Insufficient funds or validation error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        "500":
          description: Internal server error

  # ----------------------------------------------------------
  # Transfer endpoint
  # ----------------------------------------------------------
  /v1/transfer:
    post:
      summary: Transfer funds between accounts
      description: |
        Transfers funds from one account to another.
        This operation creates a transaction group
        and executes debit and credit atomically.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TransferRequest'
      responses:
        "201":
          description: Transfer completed successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransactionResponse'
        "401":
          description: Missing or invalid API key
        "422":
          description: Validation error or insufficient funds
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        "500":
          description: Internal server error
